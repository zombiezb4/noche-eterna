# Copia este archivo como .env SOLO en tu máquina o en el panel de Render.
# Nunca subas el .env real a GitHub.

# Cadena de conexión POOLED de Neon (botón Connect en el panel de Neon,
# activa "Connection pooling"; el host trae "-pooler").
# Formato: postgresql://USUARIO:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Secreto para firmar sesiones del login (Render lo genera solo si usas render.yaml)
SESSION_SECRET=
